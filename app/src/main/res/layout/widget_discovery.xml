<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/discover_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0A1931" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/discover_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#DDEAFF" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/discover_kind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A9BBDA" android:textSize="10sp"/>
    </LinearLayout>
    <ImageView android:id="@+id/discover_image" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop" android:contentDescription="NASA 천체 사진 또는 출처가 명시된 임시 그래픽"/>
    <TextView android:id="@+id/discover_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"/>
    <TextView android:id="@+id/discover_fact" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#C5D7ED" android:ellipsize="end" android:maxLines="2"/>
    <TextView android:id="@+id/discover_attribution" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="8sp" android:textColor="#819ABB" android:maxLines="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="27dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/discover_fav" android:layout_width="55dp" android:layout_height="match_parent" android:gravity="center" android:textSize="17sp" android:textColor="#FFD8A0" android:background="#1D3350" android:text="☆"/>
        <TextView android:id="@+id/discover_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:textSize="11sp" android:textColor="#FFFFFF" android:background="#263F60" android:text="↻ 다른 천체"/>
    </LinearLayout>
</LinearLayout>
